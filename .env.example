# ─────────────────────────────────────────────────────────────────────────────
# StationPro — variables d'environnement
#
# Dashboard Supabase → Project Settings → API : copiez « Project URL » et la
# clé « anon public » ci-dessous.
#
# ⚠ Vite lit ces variables au BUILD, pas à l'exécution : après toute
#   modification, relancez `npm run dev` ou refaites un build / redeploy.
#   Sur Vercel : Project Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────────────────────

VITE_SUPABASE_URL=https://votre-projet.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# Optionnel — non requis par l'application
GEMINI_API_KEY=
